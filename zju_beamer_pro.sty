\newenvironment{zjutimeline}{%
  \begin{list}{}{\setlength{\leftmargin}{0pt}\setlength{\itemsep}{1.0mm}%
                 \setlength{\parsep}{0pt}\setlength{\topsep}{0.4mm}}}%
  {\end{list}}
\NewDocumentCommand{\titem}{m m m m}{%
  \item\relax
  \tikz[baseline=-0.9ex]\node[fill=zju#1, text=white, font=\tiny\bfseries,
    rounded corners=1.2pt, inner xsep=3.5pt, inner ysep=1.7pt]{#2};\hspace{1.4mm}%
  {\small\bfseries #3}\;\;{\footnotesize\color{black!62}#4}\par}

% ------------------------------------------------------------
% 17. 组件：imgcard 图片卡片
% ------------------------------------------------------------
\NewDocumentCommand{\imgcard}{O{0.94\linewidth} m m}{%
  \begin{tikzpicture}[baseline=(card.base)]
    \node[draw=zjublue!30, fill=white, rounded corners=1.2mm,
          inner xsep=0.8mm, inner ysep=0.9mm,
          text width=#1, align=center] (card)
      {\includegraphics[width=#1, keepaspectratio]{#2}\\[0.6mm]
       {\scriptsize\color{black!60}#3}};
  \end{tikzpicture}}

% ------------------------------------------------------------
% 17b. 组件：zjucode 代码演示框（tcolorbox listings 引擎，无需 [fragile]）
%      \begin{zjucode}{语言}{标题} ... \end{zjucode}
% ------------------------------------------------------------
\newtcblisting{zjucode}[3][]{%
  listing only, enhanced,
  colback=zjuice, colframe=zjublue!35,
  arc=1.5mm, boxrule=0.5pt,
  colbacktitle=zjublue, coltitle=white, fonttitle=\bfseries\small,
  title={#3},
  listing options={language=#2,
    basicstyle=\ttfamily\footnotesize,
    keywordstyle=\bfseries\color{zjubluedark},
    commentstyle=\itshape\color{black!50},
    stringstyle=\color{zjubluelight},
    numbers=none, breaklines=true, columns=flexible,
    showstringspaces=false, aboveskip=0.3em, belowskip=0.2em},
  #1}

