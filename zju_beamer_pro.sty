% ============================================================
%  zju_beamer_pro.sty —— 浙江大学 Beamer 高信息密度主题 v2
%  （SimplePlus 风格横线版）
% ------------------------------------------------------------
%  基于 qychen2001/ZJU-Beamer-Template（光头哥 / PhilFan）重构
%  版权沿用上游：LPPL 1.3c 或 GPL 3.0 双许可
%
%  v2 设计（对标 SimplePlus Beamer Theme 的克制风格）：
%    * 标题区：蓝色标题 + 求是蓝→深蓝渐变细横线（替代渐变横幅）
%    * 浙大校名 + 校徽渐变填充，置于横线右上方
%    * 无底部色块，仅右下角小页码；背景保留浙大校徽水印
%    * 全部彩色组件收敛为蓝色系阶梯（求是蓝/蔚蓝/天蓝/靛蓝/蓝灰），
%      block 采用 SimplePlus 式「色块标题条 + 嫩色浅底」
%    * 中文得意黑（Smiley Sans，随 fonts/ 分发），西文 Latin Modern Sans
%    * 组件：zjubox / takeaway / statcard / awardcard / zjutimeline /
%      imgcard / badge / denseitem
%
%  使用：\documentclass[10pt,aspectratio=169]{beamer}
%        \usepackage{zju_beamer_pro}
%  编译：latexmk -xelatex main.tex
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{zju_beamer_pro}[2026/09/16 v2.0 ZJU Beamer Pro (SimplePlus line style)]

% ------------------------------------------------------------
% 1. 宏包
% ------------------------------------------------------------
% 说明：如需统计图表，请在 main.tex 导言区自行加载
%       \usepackage{pgfplots}\pgfplotsset{compat=1.18}
%       （模板默认不加载，以缩短 Overleaf 编译时间）
\usefonttheme[onlymath]{serif}                 % 数学公式衬线
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\PassOptionsToPackage{fontset=none}{ctex}      % 跳过 ctex 系统字体探测（加快加载）
\RequirePackage{ctex}

\RequirePackage{amsmath,amsfonts,amssymb,bm}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{multicol}
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,arrows.meta}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable,hooks,listings}
\RequirePackage{fontawesome5}
\RequirePackage{hyperref,url}

% ------------------------------------------------------------
% 2. 字体（参考 slides.tonycrane.cc/data-sec-pre 的字体层级）
%    大标题：得意黑 Smiley Sans + 西文 Fira Italic（\zjutitlefont）
%    二级标题：文楷加粗（正体）；正文：霞鹜文楷 LXGW WenKai（手写楷体感）
%    文楷/得意黑随 fonts/ 目录分发；无 fira 环境回退 LM Sans
% ------------------------------------------------------------
\IfFileExists{FiraSans-Regular.otf}{%
  \setsansfont{FiraSans-Regular.otf}[%
    BoldFont=FiraSans-Bold.otf,%
    ItalicFont=FiraSans-Italic.otf,%
    BoldItalicFont=FiraSans-BoldItalic.otf]%
}{}

% 文楷单字重 + AutoFakeBold（省一次大字体文件加载）
\IfFileExists{fonts/LXGWWenKai-Regular.ttf}{%
  \setCJKsansfont{LXGWWenKai-Regular}[Path=fonts/,Extension=.ttf,AutoFakeBold=2.8]%
  \setCJKmainfont{LXGWWenKai-Regular}[Path=fonts/,Extension=.ttf,AutoFakeBold=2.8]%
}{%
  \IfFontExistsTF{LXGW WenKai}{%
    \setCJKsansfont{LXGW WenKai}[AutoFakeBold=2.8]%
    \setCJKmainfont{LXGW WenKai}[AutoFakeBold=2.8]%
  }{%
    \IfFontExistsTF{PingFang SC}{%
      \setCJKsansfont{PingFang SC}%
      \setCJKmainfont{PingFang SC}%
    }{}%
  }%
}

% 中文大标题族：得意黑；西文随 \itshape 切 Fira Italic
\IfFileExists{fonts/SmileySans-Oblique.ttf}{%
  \setCJKfamilyfont{zjusk}{SmileySans-Oblique}[Path=fonts/,Extension=.ttf,AutoFakeBold=2.6]%
}{%
  \IfFontExistsTF{Smiley Sans}{%
    \setCJKfamilyfont{zjusk}{Smiley Sans}[AutoFakeBold=2.6]%
  }{%
    \IfFontExistsTF{LXGW WenKai}{%
      \setCJKfamilyfont{zjusk}{LXGW WenKai}%
    }{}%
  }%
}
% 标题包装：frametitle / 封面标题 / 章节标题 / takeaway 内使用
\newcommand{\zjutitlefont}{\CJKfamily{zjusk}\itshape}

% 圈号、罗马数字等符号走中文字体（避免西文字体缺字形）
\xeCJKDeclareCharClass{CJK}{"2460 -> "24FF}
\xeCJKDeclareCharClass{CJK}{"2160 -> "217F}

% ------------------------------------------------------------
% 3. 配色：全蓝色系阶梯（SimplePlus 式嫩色调）
%    主阶：求是蓝 zjublue → 深蓝 zjubluedark（横线与渐变专用）
%    组件阶：azure / sky / indigo / steel，正文底色一律嫩蓝浅色
% ------------------------------------------------------------
\definecolor{zjublue}{RGB}{0,63,136}        % 求是蓝（主色）
\definecolor{zjubluedark}{RGB}{0,40,88}     % 深蓝（渐变末端）
\definecolor{zjubluelight}{RGB}{0,110,182}  % 蔚蓝（次级）
\definecolor{zjusky}{RGB}{64,150,218}       % 天蓝（嫩）
\definecolor{zjuindigo}{RGB}{30,42,105}     % 靛蓝（强调/警示）
\definecolor{zjusteel}{RGB}{96,114,140}     % 蓝灰（中性）
\definecolor{zjuice}{RGB}{236,243,250}      % 冰蓝（浅底）

% 语义色名沿用旧 API，但全部映射到蓝色阶梯（block 一律为蓝）
\colorlet{zjuorange}{zjubluelight}%
\colorlet{zjugreen}{zjusky}%
\colorlet{zjupurple}{zjuindigo}%
\colorlet{zjured}{zjuindigo}%
\colorlet{zjugold}{zjusky}%
\colorlet{zjugray}{zjusteel}%
\colorlet{zjuteal}{zjubluelight}%
% 奖牌层级（awardcard）：金/银/铜 → 深/中/浅蓝阶
\colorlet{zjusilver}{zjusteel}%
\colorlet{zjubronze}{zjubluelight}%

\hypersetup{urlcolor=zjublue, linkcolor=zjublue, citecolor=zjublue}

% ------------------------------------------------------------
% 4. 版面：16:9，去导航与页眉，背景保留浙大校徽水印
% ------------------------------------------------------------
\setbeamersize{text margin left=0.55cm, text margin right=0.55cm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}

\setbeamertemplate{background}{}

% 列表符号
\setbeamertemplate{itemize item}{\scriptsize\raise1.4pt\hbox{\textcolor{zjublue}{\ensuremath{\blacktriangleright}}}}
\setbeamertemplate{itemize subitem}{\scriptsize\raise1.2pt\hbox{\textcolor{zjublue!55}{\ensuremath{\bullet}}}}
\setbeamertemplate{itemize subsubitem}{\scriptsize\raise0.9pt\hbox{\textcolor{black!45}{\ensuremath{\textendash}}}}
\setbeamertemplate{enumerate item}{\textcolor{zjublue}{\textbf{\insertenumlabel.}}}
\setbeamertemplate{enumerate subitem}{\textcolor{zjublue!70}{\insertenumlabel.\insertsubenumlabel.}}
\setlength{\leftmargini}{1.35em}
\setlength{\leftmarginii}{1.2em}

% 紧凑列表环境
\newenvironment{denseitem}{%
  \begin{itemize}\setlength{\itemsep}{0.08em}\setlength{\parskip}{0pt}\setlength{\topsep}{0.1em}}{\end{itemize}}
\newenvironment{denseenum}{%
  \begin{enumerate}\setlength{\itemsep}{0.15em}\setlength{\parskip}{0pt}\setlength{\topsep}{0.2em}}{\end{enumerate}}

% ------------------------------------------------------------
% 5. beamer 原生 block：SimplePlus 式（色块标题条 + 嫩蓝浅底，无阴影）
% ------------------------------------------------------------
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamercolor{block title}{fg=white,bg=zjublue}
\setbeamercolor{block body}{fg=black!88,bg=zjublue!5}
\setbeamercolor{block title alerted}{fg=white,bg=zjubluelight}
\setbeamercolor{block body alerted}{fg=black!88,bg=zjubluelight!6}
\setbeamercolor{block title example}{fg=white,bg=zjusky}
\setbeamercolor{block body example}{fg=black!88,bg=zjusky!7}

% ------------------------------------------------------------
% 6. 标题区：SimplePlus 式横线
%    上行：蓝色粗标题（+ 副标题小字）……右侧渐变校名+校徽
%    下行：求是蓝 → 深蓝渐变细线
% ------------------------------------------------------------
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamercolor{frametitle}{fg=zjublue}

% —— 右上角校名：浙江大学渐变版（figures/char_grad.png 由 char.pdf 上色生成，透明底无框）——
\newcommand{\zjubrandmark}{\includegraphics[height=0.44cm]{figures/char_grad.png}}

% —— 渐变横线（宽度 = 正文宽度，在 \begin{document} 时定宽）——
\AtBeginDocument{%
  \pgfdeclarehorizontalshading{zju@titlerule}{0.65mm}{%
    color(0pt)=(zjublue); color(\textwidth)=(zjubluedark)}%
}

\defbeamertemplate*{frametitle}{zjupro}{%
  \nointerlineskip
  \vskip0.42em
  \hbox to\textwidth{%
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\zjutitlefont
     \insertframetitle
     \ifx\insertframesubtitle\@empty\else
       \;\;{\footnotesize\mdseries\color{black!45}\insertframesubtitle}%
     \fi}%
    \hfill
    \raisebox{1.6pt}{\zjubrandmark}%
  }\par
  \nointerlineskip
  \vskip2.6pt
  \pgfuseshading{zju@titlerule}\par
  \nointerlineskip
  \vskip1.1mm
}

% ------------------------------------------------------------
% 7. 页脚：无页码
% ------------------------------------------------------------
\setbeamertemplate{footline}{}

% ------------------------------------------------------------
% 8. 整页满版通用命令 + 封面（白底 · 参考风格：左上校徽校名，大字标题垫浅蓝色带，
%    右侧浅色芯片几何装饰；与内容页画风统一）
% ------------------------------------------------------------
\newcommand{\zjufullbleed}[1]{%
  \nointerlineskip
  \hbox{\leavevmode\hskip-\Gm@lmargin#1\hskip-\Gm@rmargin}}

% 玉泉曹光彪楼水印 —— 楼体使用手绘透视立面（figures/caoguangbiao.tex，
% standalone 编译为 caoguangbiao.pdf，透明底）；章节/致谢页：底部贯穿
% 整页的地面横线 + 缩小的楼体
\newcommand{\zju@landmark}[1]{%
  \begin{scope}[shift={#1}]
    \fill[black!3] (-14,0) rectangle (6.5,-1.05);
    \draw[black!10,line width=0.5pt] (-14,0) -- (6.5,0);
    \node[overlay,anchor=south west,inner sep=0pt] at (0.2,0)
      {\includegraphics[width=4.4cm]{figures/caoguangbiao.pdf}};
  \end{scope}}

% 封面角部版（右上，稍大）：CUHK 合一亭式岸线楔形底座，向右出血
\newcommand{\zju@landmarkcorner}[1]{%
  \begin{scope}[shift={#1}]
    \fill[black!3] (-1.2,0) -- (-0.95,-0.18) -- (-0.55,-0.34) -- (-0.1,-0.48) --
                   (0.4,-0.6) -- (6.5,-0.6) -- (6.5,0) -- cycle;
    \draw[black!10,line width=0.5pt] (-1.2,0) -- (6.5,0);
    \node[overlay,anchor=south west,inner sep=0pt] at (0,0)
      {\includegraphics[width=5.6cm]{figures/caoguangbiao.pdf}};
  \end{scope}}
% 封底角部版（右上）：底座横线 + 浅色基座
\newcommand{\zju@landmarkthanks}[1]{%
  \begin{scope}[shift={#1}]
    \fill[black!5] (-0.7,0) rectangle (8.0,-0.09);
    \draw[black!10,line width=0.5pt] (-0.7,0) -- (8.0,0);
    \node[overlay,anchor=south west,inner sep=0pt] at (0,0)
      {\includegraphics[width=5.6cm]{figures/caoguangbiao.pdf}};
  \end{scope}}

\defbeamertemplate*{title page}{zjupro}{%
  \zjufullbleed{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,-\paperheight);
    \fill[white] (0,0) rectangle (\paperwidth,-\paperheight);
    % —— 右上角曹光彪楼水印（CUHK 式岸线底座）——
    \zju@landmarkcorner{(\paperwidth-5.9cm,-3.9cm)}
    % —— 左上校徽 + 校名（本蓝）——
    \node[overlay,anchor=north west,inner sep=0pt] at (1.05cm,-0.9cm)
      {\includegraphics[height=1.5cm]{figures/logo_blue.png}};
    \node[overlay,anchor=north west,inner sep=0pt] at (1.07cm,-2.6cm)
      {\includegraphics[height=0.5cm]{figures/char_blue.png}};
    % —— 标题 + 浅蓝色带 ——
    \fill[zjublue!12] (1.0cm,-4.5cm) rectangle (\paperwidth-1.0cm,-5.6cm);
    \node[overlay,anchor=west,text=zjublue,font=\zjutitlefont\fontsize{22.5}{27}\selectfont\bfseries,
          text width=0.72\paperwidth] at (1.3cm,-5.05cm)
      {\inserttitle};
    % —— 副标题 / 汇报人 ——
    \node[overlay,anchor=west,text=black!82,font=\large\bfseries] at (1.05cm,-6.35cm)
      {\insertsubtitle};
    \node[overlay,anchor=west,text=black!88,font=\normalsize\bfseries,align=left] at (1.05cm,-7.15cm)
      {\insertauthor};
    \node[overlay,anchor=west,text=black!55,font=\footnotesize] at (1.05cm,-7.75cm)
      {\insertinstitute};
    % —— 日期（右下）——
    \node[overlay,anchor=east,text=black!45,font=\footnotesize] at (\paperwidth-1.0cm,-8.3cm)
      {\insertdate};
  \end{tikzpicture}}%
}

% ------------------------------------------------------------
% 9. 章节过渡页（\AtBeginSection 自动插入；白底水印 + 大字标题垫浅蓝色带）
% ------------------------------------------------------------
\newif\ifzjusectionpages \zjusectionpagestrue
\newcommand{\nosectionpages}{\zjusectionpagesfalse}
\newcommand{\zjusectionpage}{%
  \zjufullbleed{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,-\paperheight);
    \fill[white] (0,0) rectangle (\paperwidth,-\paperheight);
    % 左上角校徽 + 校名（与封面一致）
    \node[overlay,anchor=north west,inner sep=0pt] at (1.05cm,-0.9cm)
      {\includegraphics[height=1.5cm]{figures/logo_blue.png}};
    \node[overlay,anchor=north west,inner sep=0pt] at (1.07cm,-2.6cm)
      {\includegraphics[height=0.5cm]{figures/char_blue.png}};
    % 右下角淡色芯片装饰 + 巨大幽灵章节号
    \zju@landmark{(\paperwidth-4.9cm,-8.0cm)}
    \node[overlay,anchor=east,text=zjublue!10,
          font=\zjutitlefont\fontsize{110}{110}\selectfont\bfseries]
      at (\paperwidth-0.7cm,-2.6cm) {\insertsectionnumber};
    % 小标签
    \node[overlay,anchor=west,text=zjublue!80,font=\small\bfseries]
      at (1.1cm,-3.55cm) {第 \insertsectionnumber\ 部分\; · \; PART \insertsectionnumber};
    \fill[zjublue] (1.12cm,-3.95cm) rectangle (3.55cm,-4.02cm);
    % 标题垫浅蓝色带
    \fill[zjublue!12] (1.05cm,-4.45cm) rectangle (\paperwidth-1.0cm,-5.65cm);
    \node[overlay,anchor=west,text=black!88,font=\zjutitlefont\fontsize{23}{27}\selectfont\bfseries,
          text width=0.74\paperwidth] at (1.35cm,-5.05cm)
      {\insertsection};
  \end{tikzpicture}}%
}
\AtBeginSection[]{%
  \ifzjusectionpages
    {\begin{frame}[plain]\zjusectionpage\end{frame}}%
  \fi
}

% 致谢页署名信息（使用前 \renewcommand 定制）
\newcommand{\zjuthanksinfo}{ZJU Beamer Template · \today}

% ------------------------------------------------------------
% 9b. 致谢页（白底，与封面/章节页同风格；\begin{frame}[plain]\zjuthanks\end{frame}）
% ------------------------------------------------------------
\newcommand{\zjuthanks}{%
  \zjufullbleed{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,-\paperheight);
    \fill[white] (0,0) rectangle (\paperwidth,-\paperheight);
    % —— 右上角曹光彪楼水印（底座横线 + 浅色基座）——
    \zju@landmarkthanks{(\paperwidth-6.0cm,-4.1cm)}
    % 左上校徽 + 校名
    \node[overlay,anchor=north west,inner sep=0pt] at (1.05cm,-0.9cm)
      {\includegraphics[height=1.5cm]{figures/logo_blue.png}};
    \node[overlay,anchor=north west,inner sep=0pt] at (1.07cm,-2.6cm)
      {\includegraphics[height=0.5cm]{figures/char_blue.png}};
    % 大字致谢 + 浅蓝色带
    \fill[zjublue!12] (1.0cm,-4.3cm) rectangle (\paperwidth-1.0cm,-5.5cm);
    \node[overlay,anchor=west,text=zjublue,font=\zjutitlefont\fontsize{26}{30}\selectfont\bfseries]
      at (1.3cm,-4.9cm) {恳请各位老师批评指正};
    \node[overlay,anchor=west,text=black!82,font=\large\bfseries] at (1.05cm,-6.35cm)
      {谢谢！};
    \node[overlay,anchor=west,text=black!55,font=\footnotesize] at (1.05cm,-7.0cm)
      {\zjuthanksinfo};
  \end{tikzpicture}}%
}

% ------------------------------------------------------------
% 10. 目录样式：数字色块 + 当前章节高亮
% ------------------------------------------------------------
\setbeamercolor{section in toc}{fg=black!80}
\setbeamerfont{section in toc}{size=\large,series=\bfseries}
\setbeamertemplate{section in toc}{%
  \tikz[baseline=-0.7ex]\node[fill=zjublue!18,text=zjublue,font=\footnotesize\bfseries,
    rounded corners=1.5pt,inner sep=2.4pt,minimum width=1.55em,align=center]
    {\inserttocsectionnumber};\hspace{0.65em}\inserttocsection\par}
\setbeamercolor{section in toc current}{fg=zjublue}
\setbeamerfont{section in toc current}{size=\large,series=\bfseries}
\setbeamertemplate{section in toc current}{%
  \tikz[baseline=-0.7ex]\node[fill=zjublue,text=white,font=\footnotesize\bfseries,
    rounded corners=1.5pt,inner sep=2.4pt,minimum width=1.55em,align=center]
    {\inserttocsectionnumber};\hspace{0.65em}\inserttocsection\par}
\setbeamertemplate{subsection in toc}{%
  \hspace{1.9em}{\textcolor{zjublue!55}{\scriptsize$\circ$}}\hspace{0.5em}\inserttocsubsection\par}

% ------------------------------------------------------------
% 11. 组件：zjubox（SimplePlus 式：色块标题条 + 嫩蓝浅底，无边框）
%     \begin{zjubox}{blue|orange|green|purple|red|gold|gray}{标题}
%     （色键已全部映射到蓝色阶梯）
% ------------------------------------------------------------
\newtcolorbox{zjubox}[3][]{%
  enhanced,
  code={\colorlet{zju@c}{zju#2}},
  colframe=zju@c, colback=zju@c!5,
  colbacktitle=zju@c, coltitle=white,
  fonttitle=\bfseries\small,
  title={#3},
  boxrule=0pt, arc=2mm, left=2.4mm, right=2.4mm, top=1.0mm, bottom=1.2mm,
  toptitle=0.7mm, bottomtitle=0.7mm,
  #1}

% ------------------------------------------------------------
% 12. 组件：takeaway 全宽渐变要点条（求是蓝渐变 + 天蓝侧标）
% ------------------------------------------------------------
% 深蓝底条内的高亮色（takeaway 内部把 \hl/\hlo 局部切换到此定义）
\newcommand{\zju@tkhl}[1]{\textcolor{white!45!zjusky}{\textbf{#1}}}
\newtcolorbox{takeaway}{%
  enhanced,
  interior style={left color=zjublue, right color=zjubluedark!92!black},
  colupper=white, fontupper={\zjutitlefont\bfseries\small},
  boxrule=0pt, arc=1.4mm, left=3.2mm, right=3.2mm, top=1.2mm, bottom=1.2mm,
  before skip=1.6mm, after skip=0.6mm,
  borderline west={3pt}{0pt}{zjusky},
  before upper={\textcolor{white!85!zjublue}{\faIcon{bolt}}\hspace{1.8mm}%
    \let\hl\zju@tkhl\let\hlo\zju@tkhl}}

% ------------------------------------------------------------
% 13. 组件：statcard 数据卡片（tikz 水平盒，可 \hfill 并排；SimplePlus 式嫩蓝浅底）
% ------------------------------------------------------------
\newdimen\zjustatwidth \zjustatwidth=3.3cm
\NewDocumentCommand{\statcard}{O{blue} m m}{%
  \begin{tikzpicture}[baseline=(card.base)]
    \node[draw=zju#1!30, fill=zju#1!6, rounded corners=1.6mm,
          inner xsep=1.2mm, inner ysep=1.6mm,
          minimum width=\zjustatwidth,
          text width=\dimexpr\zjustatwidth-2.4mm\relax, align=center] (card)
      {{\color{zju#1!80!black}\fontsize{13.5}{15}\selectfont\bfseries #2}\\[0.5mm]
       {\scriptsize\color{black!58}#3}};
  \end{tikzpicture}}

% ------------------------------------------------------------
% 14. 组件：badge 徽章 / hl 高亮 / ic 图标
% ------------------------------------------------------------
\NewDocumentCommand{\badge}{O{zjublue} m}{%
  \tikz[baseline=-0.65ex]\node[fill=#1, text=white, font=\scriptsize\bfseries,
    rounded corners=1.5pt, inner xsep=4.5pt, inner ysep=2.2pt]{#2};}
\newcommand{\hl}[1]{\textcolor{zjublue}{\textbf{#1}}}
\newcommand{\hlo}[1]{\textcolor{zjuindigo}{\textbf{#1}}}
\NewDocumentCommand{\ic}{O{zjublue} m}{\textcolor{#1}{\faIcon{#2}}}

% ------------------------------------------------------------
% 15. 组件：awardcard 奖项卡片（蓝阶侧条，可排 2×2 网格）
% ------------------------------------------------------------
\newdimen\zjuawardwidth \zjuawardwidth=7.15cm
\NewDocumentCommand{\awardcard}{O{gold} m m m m}{%
  \begin{tikzpicture}[baseline=(card.base)]
    \node[draw=zju#1!35, fill=white, rounded corners=1.6mm,
          inner xsep=2mm, inner ysep=1.4mm,
          text width=\dimexpr\zjuawardwidth-6.4mm\relax, align=left] (card)
      {\begin{tikzpicture}[baseline=-2.6ex]
         \node[circle, fill=zju#1!10, text=zju#1!80!black, minimum size=0.78cm, inner sep=0pt]
           {\faIcon{#2}};
       \end{tikzpicture}\hspace{1.4mm}%
       \badge[zju#1]{#3}\hspace{1.2mm}{\small\bfseries #4}\\[0.7mm]
       {\footnotesize\color{black!60}#5}};
    \fill[zju#1, rounded corners=0.9mm]
      ($(card.south west)+(0.55mm,1.0mm)$) rectangle ($(card.north west)+(-1.75mm,-1.0mm)$);
  \end{tikzpicture}}

